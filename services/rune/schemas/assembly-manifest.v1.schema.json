{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rune.local/schemas/assembly-manifest.v1.schema.json",
  "title": "RUNE composite assembly manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contractVersion",
    "mode",
    "parts"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0"
    },
    "mode": {
      "enum": [
        "logical",
        "rendered",
        "hybrid",
        "auto"
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "sourceType",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sourceType": {
            "enum": [
              "markdown",
              "html",
              "pdf",
              "template",
              "composite"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "preservation": {
            "type": "object"
          },
          "diagnostics": {
            "type": "array"
          }
        }
      }
    },
    "crossReferences": {
      "type": "array"
    },
    "diagnostics": {
      "type": "array"
    },
    "finalArtifactSha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
